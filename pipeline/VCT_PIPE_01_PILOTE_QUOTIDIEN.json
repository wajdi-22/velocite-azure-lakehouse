{
  "name": "VCT_PIPE_01_PILOTE_QUOTIDIEN",
  "properties": {
    "description": "Pilote VELOCITE : collecte multi-sources, staging, qualite, publication Delta, agregats, puis validation des watermarks. Concurrence limitee a un lot.",
