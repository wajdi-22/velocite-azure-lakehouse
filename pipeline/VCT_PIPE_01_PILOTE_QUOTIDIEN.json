        "userProperties": [],
        "linkedServiceName": {
          "referenceName": "VCT_LS_SQL",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "Query",
              "text": {
                "value": "@concat('SET XACT_ABORT ON; BEGIN TRANSACTION; UPDATE w SET last_success=CASE WHEN r.upper_bound>w.last_success THEN r.upper_bound ELSE w.last_success END FROM vct_ops.Watermark w CROSS JOIN vct_ops.RunLog r WHERE r.run_id=''',pipeline().RunId,''' AND w.entity IN(''abonnes'',''locations''); UPDATE vct_ops.RunLog SET ended_at=SYSUTCDATETIME(),status=''Succeeded'',details=''SQL, CSV, REST, qualite, Delta et consommation publies'' WHERE run_id=''',pipeline().RunId,'''; COMMIT; SELECT run_id,status,rows_read,rows_valid,rows_rejected FROM vct_ops.RunLog WHERE run_id=''',pipeline().RunId,''';')",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:20:00"
        }
