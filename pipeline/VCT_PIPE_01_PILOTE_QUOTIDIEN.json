        "typeProperties": {
          "pipeline": {
            "referenceName": "VCT_PIPE_10_SQL_VERS_BRUT",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "BatchId": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "UpperBound": {
              "value": "@activity('FixerFenetreDuLot').output.firstRow.upper_bound",
              "type": "Expression"
            }
          }
        }
