          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": {
              "value": "@concat('SET NOCOUNT ON; DECLARE @r varchar(64)=''',pipeline().RunId,'''; IF NOT EXISTS(SELECT 1 FROM vct_ops.RunLog WHERE run_id=@r) INSERT vct_ops.RunLog(run_id,started_at,status,upper_bound,details)VALUES(@r,SYSUTCDATETIME(),''Running'',SYSUTCDATETIME(),''VCT daily batch''); SELECT CONVERT(varchar(33),upper_bound,126) upper_bound FROM vct_ops.RunLog WHERE run_id=@r;')",
              "type": "Expression"
            },
            "queryTimeout": "00:20:00",
            "partitionOption": "None"
          },
          "dataset": {
            "referenceName": "VCT_DS_SQL_TABLE",
            "type": "DatasetReference",
            "parameters": {
              "Schema": "vct_ops",
              "Table": "RunLog"
            }
          },
          "firstRowOnly": true
        }
      },
